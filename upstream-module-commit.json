[{"sha":"e817f5043f27d4e4385b2cb49ba84abd3bb2677c","node_id":"C_kwDOSoRZwtoAKGU4MTdmNTA0M2YyN2Q0ZTQzODViMmNiNDliYTg0YWJkM2JiMjY3N2M","commit":{"author":{"name":"gogrhw","email":"guogh2000@outlook.com","date":"2026-10-26T14:50:02Z"},"committer":{"name":"gogrhw","email":"guogh2000@outlook.com","date":"2026-10-26T14:50:02Z"},"message":"Load YouTube Subscriptions feed directly on Home\n\nWith subsTabOnly, Home used to load the full FEwhat_to_watch page first\nand then fetch the Subscriptions tab via continuation: two serial\nbrowse requests (~2.3s + ~2.8s). Add a request script that rewrites the\nHome browse request's browseId to FEsubscriptions, so a single request\nreturns the subscriptions feed (channel bar, filters, videos) inline.\nContinuation and other browse requests pass through untouched.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"32c2fbfb66ca072fc11e0593810f9db61500611f","url":"https://api.github.com/repos/gogrhw/surge/git/trees/32c2fbfb66ca072fc11e0593810f9db61500611f"},"url":"https://api.github.com/repos/gogrhw/surge/git/commits/e817f5043f27d4e4385b2cb49ba84abd3bb2677c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/gogrhw/surge/commits/e817f5043f27d4e4385b2cb49ba84abd3bb2677c","html_url":"https://github.com/gogrhw/surge/commit/e817f5043f27d4e4385b2cb49ba84abd3bb2677c","comments_url":"https://api.github.com/repos/gogrhw/surge/commits/e817f5043f27d4e4385b2cb49ba84abd3bb2677c/comments","author":{"login":"gogrhw","id":160451739,"node_id":"U_kgDOCZBMmw","avatar_url":"https://avatars.githubusercontent.com/u/160451739?v=4","gravatar_id":"","url":"https://api.github.com/users/gogrhw","html_url":"https://github.com/gogrhw","followers_url":"https://api.github.com/users/gogrhw/followers","following_url":"https://api.github.com/users/gogrhw/following{/other_user}","gists_url":"https://api.github.com/users/gogrhw/gists{/gist_i